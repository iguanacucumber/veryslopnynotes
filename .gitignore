# Secrets — jamais dans le dépôt ni l'historique
.env*
!.env.example
*.pem
*.key
*.keystore
*.jks
secrets/
playwright/.auth/
playwright/storageState*.json
**/storageState*.json

# Local
.env.local
*.local

# Captures d'écran et frames de référence (#133) : l'écran d'accueil affiche le
# VRAI nom, l'établissement, les devoirs et les notes du téléphone de l'agent.
/shots/
/ref-papillon/

# Données personnelles / établissement / manuels
/data/
/downloads/
/manuels/
/cours/
*.pdf
!docs/**/*.pdf
/media/
/attachments/

# Build outputs
node_modules/
dist/
build/
coverage/
*.apk
*.aab
android/**/build/
android/**/.gradle/
# Chemin du SDK Android local + config hôte serveur : propre à la machine.
# Le modèle (server.host) est dans android/README.md, jamais le chemin réel.
android/local.properties
android/local-defaults.properties
server/data/
*.db
*.sqlite
*.sqlite-journal

# OS / éditeurs
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Bun
bun.lockb
.bun-cache/

# Logs
logs/
*.log
npm-debug.log*
