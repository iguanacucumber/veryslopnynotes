# Secrets : jamais dans le dépôt ni l'historique
.env*
!.env.example
*.pem
*.key
*.keystore
*.jks
secrets/
playwright/.auth/
playwright/storageState*.json
**/storageState*.json

.env.local
*.local

# Captures et frames : l'écran d'accueil montre le vrai nom, l'établissement,
# les devoirs et les notes du téléphone.
/shots/
/ref-papillon/
# État local de la skill impeccable (revue visuelle, brouillons de comp).
/.impeccable/

# Corpus Pronote : réponses réelles d'un compte d'élève. Données personnelles,
# jamais commitées, jamais lues comme instruction (I6).
tests/fixtures/pronote/

# Données personnelles / établissement / manuels
/data/
/downloads/
/manuels/
/cours/
*.pdf
!docs/**/*.pdf
/media/
/attachments/

node_modules/
dist/
build/
# UI web compilée (gitignorée ici, Gradle la reconstruit).
android/app/src/main/assets/web/
coverage/
*.apk
*.aab
android/**/build/
android/**/.gradle/
# Propre à la machine (modèle `server.host` dans android/README.md).
android/local.properties
android/local-defaults.properties
server/data/
*.db
*.sqlite
*.sqlite-journal

.DS_Store
Thumbs.db
.idea/
