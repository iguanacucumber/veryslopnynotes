# Scraper de manuels seul : seuls http.ts + manuals*.ts embarqués, sans auth
# (I8, risque documenté dans server/infrastructure/http.ts).
# Base épinglée (ADR-001) : ne pas redescendre sous 1.4.4 (CVE-2026-111497,
# Brotli/node2shell/HTTP2Shell). Digest à figer quand un daemon est dispo.
FROM oven/bun:1.4.4 AS base
WORKDIR /app
# Install strict, aucun fallback : dérive interdite.
COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile
# `playwright` n'a aucun script d'installation : `bun install` ne télécharge pas
# Chromium, et `chromium.launch()` échouerait (tout scrape en 500). Téléchargé
# AU BUILD, jamais au runtime. DevDependency requise à l'exécution : ne jamais
# passer `--production`. Chemin partagé build/runtime via l'ENV ci-dessous.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN bunx playwright install --with-deps chromium
# Secrets/clés/.env* exclus via .dockerignore (jamais COPY).
COPY server ./server
COPY shared ./shared
# Non privilégié : Chromium refuse de démarrer en root sans `--no-sandbox`.
# Seul le répertoire du jar de session appartient au compte.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin vsn \
 && mkdir -p /app/playwright/.auth \
 && chown -R vsn:vsn /app/playwright
# HOME explicite : /root est non inscriptible, Chromium doit écrire son profil.
ENV HOME=/home/vsn
# HOST non forcé : l'exposition est une décision de l'opérateur.
ENV PORT=3000
EXPOSE 3000
USER vsn
# TLS obligatoire (service sans auth, I8) : jamais de repli en clair.
CMD ["sh", "-c", "if [ -z \"$TLS_CERT_FILE\" ] || [ -z \"$TLS_KEY_FILE\" ]; then echo 'scraper : TLS_CERT_FILE et TLS_KEY_FILE obligatoires (service sans auth, I8) — pas de repli en clair.' >&2; exit 1; fi; exec bun run server/infrastructure/http.ts"]
