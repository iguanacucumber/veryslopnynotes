# Scraper de manuels seul : seuls http.ts + manuals*.ts embarqués ; sans auth
# sur loopback, opt-in ALLOW_PUBLIC=1 + jeton Bearer hors loopback (I8).
# Base épinglée (ADR-001) : tag ET digest (index multi-arch, résolu le
# 2026-11-01 via le registre Docker Hub). Ne pas redescendre sous 1.4.4
# (CVE-2026-111497, Brotli/node2shell/HTTP2Shell).
FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS base
WORKDIR /app
# Install strict, aucun fallback : dérive interdite.
COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile
# `playwright` n'a aucun script d'installation : `bun install` ne télécharge pas
# Chromium, et `chromium.launch()` échouerait (tout scrape en 500). Téléchargé
# AU BUILD, jamais au runtime. DevDependency requise à l'exécution : ne jamais
# passer `--production`. Chemin partagé build/runtime via l'ENV ci-dessous.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN bunx playwright install --with-deps chromium
# Secrets/clés/.env* exclus via .dockerignore (jamais COPY).
COPY server ./server
COPY shared ./shared
# Non privilégié : Chromium refuse le sandbox en root. Le sandbox reste ACTIF
# (chromiumSandbox: true) ; la commande documentée fournit le profil seccomp
# étroit qui autorise les user namespaces (server/chromium-seccomp.json).
# Seul le répertoire du jar de session (0700) appartient au compte.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin vsn \
 && mkdir -p /app/playwright/.auth \
 && chmod 700 /app/playwright/.auth \
 && chown -R vsn:vsn /app/playwright
# HOME explicite : /root est non inscriptible, Chromium doit écrire son profil.
ENV HOME=/home/vsn
# HOST non forcé : l'exposition est une décision de l'opérateur ; la commande
# documentée publie sur 127.0.0.1 et exige un proxy authentifié au-delà.
ENV PORT=3000
EXPOSE 3000
USER vsn
# TLS obligatoire (session du serveur, I8) : jamais de repli en clair.
CMD ["sh", "-c", "if [ -z \"$TLS_CERT_FILE\" ] || [ -z \"$TLS_KEY_FILE\" ]; then echo 'scraper : TLS_CERT_FILE et TLS_KEY_FILE obligatoires (I8) — pas de repli en clair.' >&2; exit 1; fi; exec bun run server/infrastructure/http.ts"]
