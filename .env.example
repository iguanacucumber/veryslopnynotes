# Copier vers .env.local (jamais commité). Valeurs réelles uniquement en local.
# Serveur
PORT=3000
# HOST d'écoute : 127.0.0.1 par défaut (localhost). 0.0.0.0 uniquement derrière
# un reverse proxy ou dans un conteneur (Dockerfile.server le force déjà).
HOST=127.0.0.1
# Persistence serveur (SqliteStorageProvider) et chiffrement au repos : pas
# encore câblés (snapshot mémoire seul, snapshot-store.ts). Ne pas annoncer
# ici une config que le serveur ignore — réintroduire le jour du branchement.

# Téléchargement de PJ via /v1/media : échéance en ms (défaut 30000, une
# pièce jointe Pronote réelle dépasse 100 ms). Dépassement = ent_unavailable.
MEDIA_DOWNLOAD_TIMEOUT_MS=30000
# Secret de signature des refs média : sans lui, il est tiré au sort au
# démarrage et les refs signées meurent au redémarrage du serveur.
MEDIA_REF_SECRET=

# Pronote. Tout est FACULTATIF : absent, le compte s'ouvre depuis l'app via
# POST /v1/setup (QR de l'établissement ou identifiants ci-dessous), en mémoire.
# Renseignés, ces identifiants ouvrent la session au démarrage du serveur, et
# PRONOTE_URL ÉPINGLE l'établissement (le setup ne peut plus viser une autre
# école que celle-là). Utiles aussi pour `make integration` (.env.local requis).
PRONOTE_URL=
PRONOTE_USERNAME=
PRONOTE_PASSWORD=
# Type ENT/CAS de l'établissement : ninegate (défaut, seul implémenté) |
# educonnect | cas (déclarés, refusés franchement tant qu'ils ne sont pas codés)
PRONOTE_ENT_KIND=ninegate

# OpenRouter (assistant devoirs / fiches)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Push (infra #22 : URL gateway ou nom symbolique ; clés VAPID via .env.local uniquement)
PUSH_PROVIDER=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:push@example.invalid

# Manuels (comptes personnels, jamais en issues/PR/logs)
MANUAL_PLATFORM=
MANUAL_USERNAME=
MANUAL_PASSWORD=
