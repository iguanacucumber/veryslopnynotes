<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      VARIANT DEBUG UNIQUEMENT : absent en release, donc l'APK publiable ne
      répond à aucune URL extérieure.

      `veryslopnynotes://<route>` ouvre l'écran visé directement.

      `launchMode="singleTask"` : sinon une URL de second lancement créerait une
      NOUVELLE instance au-dessus de la tâche (deux écrans superposés).
    -->
    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Un scheme, UN HÔTE PAR ROUTE : une route inconnue doit faire
                     ÉCHOUER `am start`. À tenir à jour avec les `WEB_ROUTES`. -->
                <data android:scheme="veryslopnynotes" />
                <data android:host="index" />
                <data android:host="calendar" />
                <data android:host="grades" />
                <data android:host="tasks" />
                <data android:host="profile" />
                <data android:host="settings" />
                <data android:host="news" />
                <data android:host="canteen" />
                <data android:host="attendance" />
                <data android:host="messages" />
                <data android:host="pairing" />
                <data android:host="alerts" />
                <data android:host="revision-sheets" />
                <data android:host="course-notes" />
                <data android:host="prof" />
                <!-- Alias : anciens liens vers la route canonique. -->
                <data android:host="fiches" />
                <data android:host="cahier" />
                <data android:host="sanctions" />
            </intent-filter>
        </activity>
    </application>
</manifest>