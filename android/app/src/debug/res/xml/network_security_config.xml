<?xml version="1.0" encoding="utf-8"?>
<!--
  VARIANT DEBUG UNIQUEMENT : ce fichier écrase la config main pour le seul
  variant debug, la release garde la config stricte d'origine.

  `make runServer` sort un certificat AUTO-SIGNÉ et, depuis Android 7, l'app ne
  fait pas confiance aux CA installées par l'utilisateur : d'où
  `<certificates src="user" />` (installer le .crt du serveur, procédure dans
  android/README.md). La release n'accorde aucune confiance aux CA utilisateur,
  donc aucune interception possible sur l'APK publiable.

  ponytail: `src="user"` est large (toute CA installée, proxy de debug compris).
  Upgrade: épingler le certificat du serveur (`src="@raw/…">` par domaine).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>