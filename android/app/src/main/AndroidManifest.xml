<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Réseau : un seul hôte allowlist = serveur (I1). Clairtext UNIQUEMENT
         pour la boucle locale et l'alias émulateur ; ailleurs HTTPS obligatoire. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Caméra optionnelle : sinon le merger rend `android.hardware.camera.any`
         requis et l'app devient ininstallable sur un appareil sans caméra. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- Thème de FENÊTRE sans barre d'action : sinon la plateforme affiche le
         LABEL de l'app au-dessus de la WebView (+ 56 dp perdus). -->
    <!-- AUCUNE sauvegarde automatique : les payloads Pronote sont écrits EN
         CLAIR dans `filesDir/offline/`. `allowBackup="false"` coupe le cloud ;
         `dataExtractionRules` coupe le transfert appareil-à-appareil (API 31+). -->
    <application
        android:label="VerySlopyNyNotes"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Veryslopynotes"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31">
        <!-- zxing déclare `clearTaskOnLaunch="true"` : ouvrir le scan détruirait
             l'assistant. Annulé, et aperçu forcé en portrait comme l'écran du QR. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:clearTaskOnLaunch="false"
            android:screenOrientation="portrait"
            tools:node="merge"
            tools:replace="android:clearTaskOnLaunch,android:screenOrientation" />
        <!-- Pièces jointes servies au viewer externe (cache seul, jamais d'URL
             d'établissement). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="fr.veryslopnynotes.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- `adjustResize` : l'inset IME appliqué au conteneur retire le clavier
             (en edge-to-edge la fenêtre ne se redimensionne plus). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
