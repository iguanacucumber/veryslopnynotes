{
  "name": "veryslopnynotes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "make check",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-root.tsbuildinfo",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-web.tsbuildinfo",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "bun test",
    "lint": "bun run agents/runtime/check-secrets.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "pronotets": "1.0.0",
    "tough-cookie": "6.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  }
}
